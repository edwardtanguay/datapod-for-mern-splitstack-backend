{
	"name": "datapod-for-splitstack-lern-backend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "nodemon",
		"lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\""
	},
	"nodemonConfig": {
		"watch": [
			"backend"
		],
		"ext": "ts, json",
		"exec": "tsx backend/api/index.ts"
	},
	"dependencies": {
		"axios": "^1.7.9",
		"cors": "^2.8.5",
		"express": "^4.21.2",
		"lowdb": "^7.0.1",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@types/node": "^22.13.1",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"autoprefixer": "^10.4.16",
		"eslint": "^8.45.0",
		"eslint-plugin-react-hooks": "^4.6.0",
		"eslint-plugin-react-refresh": "^0.4.3",
		"nodemon": "^3.1.9",
		"prettier": "^3.0.3",
		"tsx": "^4.19.2",
		"typescript": "^5.0.2"
	}
}
